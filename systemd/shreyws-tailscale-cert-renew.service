[Unit]
Description=Renew the ShreyWS Tailscale HTTPS certificate
Documentation=file:/srv/shreyws/infra/docs/monitoring.md
Requires=tailscaled.service docker.service
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shreyws-tailscale-cert-renew
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/shreyws/secrets/traefik/tls /srv/shreyws/services/node-exporter/textfile
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
