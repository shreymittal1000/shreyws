[Unit]
Description=Export ShreyWS HTTPS certificate metrics for Prometheus
Documentation=file:/srv/shreyws/infra/docs/alerting.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shreyws-tls-metrics
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/shreyws/services/node-exporter/textfile
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
