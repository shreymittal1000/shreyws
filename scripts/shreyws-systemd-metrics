#!/usr/bin/env python3
"""Export failed systemd service state for Node Exporter's textfile collector."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import time


OUTPUT = Path(os.environ.get("OUTPUT_FILE", "/srv/shreyws/services/node-exporter/textfile/shreyws_systemd.prom"))


def prometheus_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def main() -> int:
    result = subprocess.run(
        ["systemctl", "--failed", "--type=service", "--no-legend", "--plain"],
        check=True,
        capture_output=True,
        text=True,
        timeout=20,
    )
    failed_units = []
    for line in result.stdout.splitlines():
        fields = line.lstrip("● ").split()
        if fields:
            failed_units.append(fields[0])

    firewall_service = subprocess.run(
        ["systemctl", "is-active", "--quiet", "shreyws-firewall.service"],
        check=False,
        timeout=20,
    )
    firewall_rules = subprocess.run(
        ["nft", "list", "table", "inet", "shreyws_access"],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    required_rules = (
        'iifname "tailscale0" tcp dport { 3389, 41081 } accept',
        'ip saddr 192.168.1.0/24 tcp dport { 3389, 41081 } accept',
        'ct status dnat iifname "tailscale0" tcp dport { 80, 443 } accept',
        'ct status dnat ip saddr 192.168.1.0/24 tcp dport { 80, 443 } accept',
    )
    firewall_rules_present = firewall_rules.returncode == 0 and all(
        rule in firewall_rules.stdout for rule in required_rules
    )

    now = int(time.time())
    lines = [
        "# HELP shreyws_systemd_failed_services Number of failed host systemd services.",
        "# TYPE shreyws_systemd_failed_services gauge",
        f"shreyws_systemd_failed_services {len(failed_units)}",
        "# HELP shreyws_systemd_service_failed Failed state for a host systemd service.",
        "# TYPE shreyws_systemd_service_failed gauge",
    ]
    lines.extend(
        f'shreyws_systemd_service_failed{{unit="{prometheus_escape(unit)}"}} 1'
        for unit in sorted(failed_units)
    )
    lines.extend(
        [
            "# HELP shreyws_firewall_service_active Whether the persistent ShreyWS firewall service is active.",
            "# TYPE shreyws_firewall_service_active gauge",
            f"shreyws_firewall_service_active {int(firewall_service.returncode == 0)}",
            "# HELP shreyws_firewall_rules_present Whether the expected SSH, RDP, and web restrictions are loaded.",
            "# TYPE shreyws_firewall_rules_present gauge",
            f"shreyws_firewall_rules_present {int(firewall_rules_present)}",
            "# HELP shreyws_systemd_metrics_last_success_timestamp_seconds Unix timestamp of the last successful collection.",
            "# TYPE shreyws_systemd_metrics_last_success_timestamp_seconds gauge",
            f"shreyws_systemd_metrics_last_success_timestamp_seconds {now}",
        ]
    )

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}")
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o644)
    os.replace(temporary, OUTPUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
