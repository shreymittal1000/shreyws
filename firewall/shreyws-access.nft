table inet shreyws_access {
    chain input {
        type filter hook input priority -5; policy accept;

        ct state established,related accept

        # Administrative access is permitted through Tailscale or the trusted LAN.
        iifname "tailscale0" tcp dport { 3389, 41081 } accept
        ip saddr 192.168.1.0/24 tcp dport { 3389, 41081 } accept

        # Reject SSH and RDP arriving from every other network, including public IPv6.
        tcp dport { 3389, 41081 } counter drop
    }

    chain forward {
        type filter hook forward priority -5; policy accept;

        ct state established,related accept

        # Docker publishes Traefik through forwarding rather than host input.
        # Keep HTTPS/HTTP reachable from Tailscale, the trusted LAN, and the host.
        ct status dnat iifname "lo" tcp dport { 80, 443 } accept
        ct status dnat iifname "tailscale0" tcp dport { 80, 443 } accept
        ct status dnat ip saddr 192.168.1.0/24 tcp dport { 80, 443 } accept

        # Reject published web ingress from every other network.
        ct status dnat tcp dport { 80, 443 } counter drop
    }
}
